# ─────────────────────────────────────────────────────────────────────────────
# Re-pointing seam: build/validate on historical data (2022/2024), flip to 2026
# when registrations open (~15 Aug 2026). Changing these is a CONFIG change, not
# a code change.
# ─────────────────────────────────────────────────────────────────────────────
RESUMO_ELECTION_YEAR=2026
# Optional: TSE election code (CD_ELEICAO). Leave blank to ingest all turns in the year.
RESUMO_CD_ELEICAO=
# Câmara legislatura: 57 = 2023-2027 (the incumbents who may seek re-election in 2026).
RESUMO_ID_LEGISLATURA=57

# ─────────────────────────────────────────────────────────────────────────────
# Scope. The platform ships narrowed to one state so the public surface can be
# audited end-to-end. Both are comma-separated; set either to "" to remove the
# filter (RESUMO_TARGET_UFS="" = national, RESUMO_TARGET_CARGOS="" = all offices).
# CD_CARGO: 1 Presidente · 3 Governador · 5 Senador · 6 Dep. Federal
#           7 Dep. Estadual · 8 Dep. Distrital · 11 Prefeito · 13 Vereador
# ─────────────────────────────────────────────────────────────────────────────
RESUMO_TARGET_UFS=SC
RESUMO_TARGET_CARGOS=3,5,6,7

# Database (matches docker-compose.yml).
RESUMO_DATABASE_URL=postgresql+psycopg://resumo:resumo@localhost:5439/resumo

# Where downloaded PDFs (proposta de governo) and large artifacts are stored.
RESUMO_STORAGE_DIR=./data/storage

# URL prefix the site is served under. Empty for the local app and for a custom
# domain at the root; "/resumo-dos-candidatos" for a GitHub Pages project site.
RESUMO_SITE_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Official source bases. NONE of these needs a key — that is a design constraint,
# not a coincidence: the Portal da Transparência REST API would require a
# `chave-api-dados`, so emendas come from the CGU bulk file instead.
# ─────────────────────────────────────────────────────────────────────────────
RESUMO_TSE_CDN_BASE=https://cdn.tse.jus.br/estatistica/sead/odsele
RESUMO_TSE_CKAN_BASE=https://dadosabertos.tse.jus.br/api/3/action
RESUMO_CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2
RESUMO_SENADO_API_BASE=https://legis.senado.leg.br/dadosabertos

# ALESC has no API; three separate hosts back it. `alesc_id_legislatura` 20 =
# 2023-2027 — the e-Legis portal has NO data before Feb 2023.
RESUMO_ALESC_SITE_BASE=https://www.alesc.sc.gov.br
RESUMO_ALESC_ELEGIS_BASE=https://portalelegis.alesc.sc.gov.br
RESUMO_ALESC_TRANSPARENCIA_BASE=https://transparencia.alesc.sc.gov.br
RESUMO_ALESC_ID_LEGISLATURA=20

RESUMO_EMENDAS_BULK_URL=https://dadosabertos-download.cgu.gov.br/PortalDaTransparencia/saida/emendas-parlamentares/EmendasParlamentares.zip

# Be a polite client: identify yourself and throttle (avoids WAF/IP blocks).
# ⚠️ TROQUE contato@example.org por um contato real antes de coletar de um IP
# compartilhado (CI ou servidor). Nenhuma fonte tem chave de API, então este header
# é a única forma de te identificarem em vez de bloquearem.
RESUMO_HTTP_USER_AGENT=resumo-dos-candidatos/0.1 (transparencia eleitoral; contato@example.org)
RESUMO_REQUEST_DELAY_SECONDS=0.2
RESUMO_HTTP_TIMEOUT_SECONDS=60
