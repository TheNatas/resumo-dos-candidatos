# ─────────────────────────────────────────────────────────────────────────────
# Re-pointing seam: build/validate on historical data (2022/2024), flip to 2026
# when registrations open (~15 Aug 2026). Changing these is a CONFIG change, not
# a code change.
# ─────────────────────────────────────────────────────────────────────────────
RESUMO_ELECTION_YEAR=2022
# Optional: TSE election code (CD_ELEICAO). Leave blank to ingest all turns in the year.
RESUMO_CD_ELEICAO=
# Câmara legislatura: 57 = 2023-2027 (the incumbents who may seek re-election in 2026).
RESUMO_ID_LEGISLATURA=57

# Database (matches docker-compose.yml).
RESUMO_DATABASE_URL=postgresql+psycopg://resumo:resumo@localhost:5435/resumo

# Where downloaded PDFs (proposta de governo) and large artifacts are stored.
RESUMO_STORAGE_DIR=./data/storage

# Official source bases (no auth, no keys).
RESUMO_TSE_CDN_BASE=https://cdn.tse.jus.br/estatistica/sead/odsele
RESUMO_TSE_CKAN_BASE=https://dadosabertos.tse.jus.br/api/3/action
RESUMO_CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2

# Be a polite client: identify yourself and throttle (avoids WAF/IP blocks).
RESUMO_HTTP_USER_AGENT=resumo-dos-candidatos/0.1 (transparencia eleitoral; contato@example.org)
RESUMO_REQUEST_DELAY_SECONDS=0.2
RESUMO_HTTP_TIMEOUT_SECONDS=60
